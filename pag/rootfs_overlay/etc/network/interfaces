auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp

#auto wlan0
iface wlan0 inet dhcp
   pre-up wpa_supplicant -B -Dnl80211 -iwlan0 -c /etc/wpa_supplicant.conf
   pre-up sleep 2
   post-up iw dev wlan0 set power_save off
   post-down killall -q wpa_supplicant

auto wlan1
iface wlan1 inet dhcp
   pre-up wpa_supplicant -B -Dnl80211 -iwlan1 -c /etc/wpa_supplicant.conf
   pre-up sleep 2
   post-up iw dev wlan1 set power_save off
   post-down killall -q wpa_supplicant
